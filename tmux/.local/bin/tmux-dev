#!/usr/bin/env bash
# tmux "dev" profile: nvim + claude + shell, three panes, one directory.
# Idempotent -- reattaches instead of duplicating if a session already
# exists for this directory. Session name is derived from the directory's
# basename, so separate projects get separate sessions.
#
# Usage: tmux-dev [dir]   # defaults to $PWD
set -euo pipefail

dir="${1:-$PWD}"
# Resolve to an absolute, canonical path before taking a basename -- a bare
# "." (dev . from inside a project) would otherwise basename to a literal
# "." and name the session "dev-.", indistinguishable across every project
# `dev .` is run from. Runs in a command substitution, so it doesn't change
# this script's own cwd.
dir="$(cd "$dir" && pwd)"

# Name after the git repo's toplevel directory when inside one, not the
# (possibly deeper) directory dev was actually invoked from -- `dev .` from
# a subdirectory of a checkout should land in the same session as `dev .`
# from its root, not fork a second one named after the subdirectory. Falls
# back to the resolved directory's own basename outside of any repo.
git_toplevel=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || true
if [[ -n "$git_toplevel" ]]; then
    name="dev-$(basename "$git_toplevel")"
else
    name="dev-$(basename "$dir")"
fi

# Every interactive shell auto-attaches to a `main` tmux session on login
# (see zsh/.zshrc), so $TMUX is normally already set by the time `dev` runs
# -- attaching a second client from inside an existing one is exactly the
# nesting tmux refuses by default ("sessions should be nested with care").
# switch-client changes what the *current* client is looking at instead of
# opening a new nested one, which is what's wanted here; plain attach still
# covers running this from outside tmux entirely (e.g. a fresh SSH login
# before the auto-attach guard's shell has started tmux).
attach_client() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$1"
    else
        exec tmux attach -t "$1"
    fi
}

if tmux has-session -t "$name" 2>/dev/null; then
    attach_client "$name"
    exit 0
fi

# Activate a project venv (matching the `.venv` name the zsh uv/python
# plugins use, see zsh/.zshrc's PYTHON_AUTO_VRUN) in the nvim and claude
# panes before launching those programs -- each pane is a fresh shell with
# no chpwd of its own to trigger the plugins' auto-activation, and nvim in
# particular needs the venv active before it starts to pick up the right
# Python interpreter for LSP.
venv_activate=""
if [[ -f "$dir/.venv/bin/activate" ]]; then
    venv_activate="source .venv/bin/activate && "
fi

tmux new-session -d -s "$name" -c "$dir" -n dev
tmux send-keys -t "$name:dev" "${venv_activate}nvim" Enter
tmux split-window -h -p 20 -t "$name:dev" -c "$dir"
tmux send-keys -t "$name:dev" "${venv_activate}claude" Enter
tmux split-window -v -t "$name:dev" -c "$dir"
tmux select-pane -t "$name:dev.{top-left}"
attach_client "$name"
