#!/usr/bin/env bash
# Dedicated, reattachable tmux session per ssh target -- mirrors
# tmux-dev/tmux-claude's session-per-context pattern, but for `ssh`
# connections instead of dev/claude work. Reconnecting to a target you'd
# detached from reattaches that same session rather than opening a new
# one -- but reconnecting to a target you're *already viewing somewhere*
# opens a fresh, additional session instead of stealing/interrupting that
# view, since that's a genuinely new connection you're making on purpose
# (e.g. a second pane of work on the same host), not a reattach.
#
# Invoked by the `ssh()` zsh function (zsh/.zshrc, macos/.zshrc), not run
# directly -- see there for the app-id/window-spawn decision that avoids
# hijacking the `main` terminal on desktop. The command sent into the new
# pane sets TMUX_SSH_ACTIVE=1 before calling `ssh` again, which the
# function checks to skip straight to the real connection instead of
# re-wrapping itself and spawning a *second*, nested tmux-ssh session for
# the same target.
#
# Usage: tmux-ssh <ssh-args...>
set -euo pipefail

# Same last-argument heuristic ssh() already uses for its title/window-
# rename signals ("ssh host" -> host, but "ssh host cmd args" -> the last
# word of the remote command instead) -- consistent, not perfect, but
# matches what the rest of this repo already accepts as good enough for a
# display label.
if [[ $# -gt 0 ]]; then
    target="${*: -1}"
else
    target="ssh"
fi

# Session names can't safely carry tmux's own target-syntax separators
# (`:` for session:window, `.` for window.pane) or arbitrary bytes a
# hostname/IPv6 literal/user@host string could contain -- collapse
# anything that isn't alnum/dash/underscore to a single underscore.
safe_target=$(printf '%s' "$target" | tr -c 'A-Za-z0-9_-' '_')
base_name="ssh-$safe_target"

# Walk ssh-<target>, ssh-<target>-2, ssh-<target>-3, ... stopping at the
# first name that's either free (no session at all -- create fresh below)
# or already exists but has no attached client (a stale/detached session
# from a previous connection -- reattach to it, so those don't pile up
# unbounded). A name that exists AND has an attached client means someone
# is actively looking at that exact session right now, so it's skipped in
# favor of the next candidate rather than reattached-into.
name="$base_name"
n=1
while tmux has-session -t "$name" 2>/dev/null && tmux list-clients -t "$name" 2>/dev/null | grep -q .; do
    n=$((n + 1))
    name="${base_name}-${n}"
done

# Mirrors tmux-dev/tmux-claude's attach_client: switch-client if already
# inside a tmux client (the common case -- every interactive shell
# auto-attaches to `main` on login), plain attach otherwise.
attach_client() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$1"
    else
        exec tmux attach -t "$1"
    fi
}

if tmux has-session -t "$name" 2>/dev/null; then
    attach_client "$name"
    exit 0
fi

# A fresh *local* session (the numbered-fallback case, n > 1) is still
# just a second client into whatever's on the far end -- and every
# managed machine's zshrc (zsh, macos, raspi) auto-attaches any plain
# interactive login to that machine's own single `main` tmux session, so
# a second `ssh host` collapses right back into the same remote session
# the first connection is already in, defeating the point of asking for
# an independent one. Only fixable when there's no explicit remote
# command to preserve (`$# -eq 1`, just the bare destination) -- ssh only
# allocates a pty without `-t`, and only sources login-shell startup
# files (zshrc, and its auto-attach) for a plain interactive login, not
# for `ssh host command`, so routing the *fallback* connection through an
# explicit `tmux new-session` command bypasses the remote auto-attach
# entirely and lands on its own fresh, independent remote session --
# mirroring Mod+Shift+Return's `foot tmux new-session` doing the same
# thing locally. Left alone (n == 1, or a non-bare invocation) still
# takes the normal path into the remote's `main`.
ssh_args=("$@")
if (( n > 1 )) && [[ $# -eq 1 ]]; then
    ssh_args=(-t "$1" tmux new-session)
fi

# Quote each argument individually so the reconstructed command line stays
# correct regardless of spaces or shell metacharacters in any of them.
# TMUX_SSH_ACTIVE is exported as its own statement (not a `VAR=val ssh`
# prefix) so it's unambiguously set for the rest of this pane's shell,
# rather than depending on zsh's prefix-assignment-to-a-function scoping
# rules -- this pane exists solely to run this one connection, so there's
# nothing else in it for a persisted export to leak into.
cmd="export TMUX_SSH_ACTIVE=1; ssh"
for arg in "${ssh_args[@]}"; do
    cmd+=" $(printf '%q' "$arg")"
done

tmux new-session -d -s "$name" -n ssh
tmux send-keys -t "$name:ssh" "$cmd" Enter
attach_client "$name"
