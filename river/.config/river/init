# layout
spawn("riverctl default-layout wideriver")
spawn_unique(
    f"wideriver \
        --layout left \
        --stack dwindle \
        --ratio-master 0.6 \
        --count-master 1 \
        --inner-gaps {PADDING} \
        --outer-gaps {PADDING}"
)

spawn_unique("waybar")
spawn_unique(f"swaybg -i {RIVER_CONFIG_FOLDER}/wallpaper.png")
spawn_unique("swayidle -w")
spawn_unique("mako")
spawn_unique("kanshi")
spawn_unique("/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &")

spawn_unique("wl-paste --watch cliphist store")

# --- 2. Input Settings ---
TOUCHPAD = "*_Touchpad"
riverctl("input", TOUCHPAD, "events", "enabled")
riverctl("input", TOUCHPAD, "tap", "enabled")
riverctl("input", TOUCHPAD, "tap-button-map", "left-right-middle")
riverctl("input", TOUCHPAD, "natural-scroll", "enabled")

# Keyboard layout is global in river, not a per-device `input` property --
# `xkb-layout`/`xkb-variant`/`xkb-options` aren't valid `input` properties at
# all (the `input` command only exposes pointer/touch settings: events,
# accel-profile, tap, natural-scroll, etc, plus map-to-output). The previous
# per-device calls here (`riverctl input keyboard-* xkb-layout gb`, etc.)
# were silently no-ops -- riverctl rejects the unknown property but nothing
# in this script checks subprocess return codes -- so the internal keyboard
# was never actually getting "gb" + caps:escape. The real, global command:
riverctl("keyboard-layout", "-options", "caps:escape", "gb")

# No riverctl mechanism exists for a different layout/variant on a specific
# keyboard (e.g. the IQUNIX MG75's "mac" variant) -- `keyboard-layout` takes
# no device-id. That needs a lower-level tool (e.g. keyd) outside river.

# --- 3. Keymaps ---
# river control
riverctl("map", "normal", f"{MOD}+Shift", "E", "exit")
riverctl("map", "normal", f"{MOD}+Shift", "C", "spawn", f"{RIVER_CONFIG_FOLDER}/init")
riverctl("map", "normal", MOD, "Q", "close")

# layout control
riverctl("map", "normal", MOD, "J", "focus-view", "next")
riverctl("map", "normal", MOD, "K", "focus-view", "previous")
riverctl("map", "normal", f"{MOD}+Shift", "J", "send-to-output", "next")
riverctl("map", "normal", f"{MOD}+Shift", "K", "send-to-output", "previous")
riverctl("map", "normal", MOD, "Tab", "zoom")
riverctl(
    "map",
    "normal",
    f"{MOD}+Shift",
    "H",
    "send-layout-cmd",
    "wideriver",
    "--ratio -0.05",
)
riverctl(
    "map",
    "normal",
    f"{MOD}+Shift",
    "L",
    "send-layout-cmd",
    "wideriver",
    "--ratio +0.05",
)

# mediakeys
riverctl(
    "map",
    "normal",
    "None",
    "XF86AudioLowerVolume",
    "spawn",
    f"{VOLUME_MIXER} set-volume @DEFAULT_SINK@ 5%-",
)
riverctl(
    "map",
    "normal",
    "None",
    "XF86AudioRaiseVolume",
    "spawn",
    f"{VOLUME_MIXER} set-volume @DEFAULT_SINK@ 5%+",
)
riverctl(
    "map",
    "normal",
    "None",
    "XF86AudioMute",
    "spawn",
    f"{VOLUME_MIXER} set-mute @DEFAULT_SINK@ toggle",
)
riverctl(
    "map",
    "normal",
    "None",
    "XF86AudioMicMute",
    "spawn",
    f"{VOLUME_MIXER} set-mute @DEFAULT_SOURCE@ toggle",
)
# apps
riverctl("map", "normal", MOD, "Return", "spawn", TERM)
riverctl("map", "normal", MOD, "E", "spawn", FILEBROWSER)

# screenshots (piped to clipboard; cliphist picks them up automatically)
riverctl("map", "normal", "None", "Print", "spawn", "grim - | wl-copy")
riverctl(
    "map",
    "normal",
    f"{MOD}+Shift",
    "S",
    "spawn",
    'grim -g "$(slurp)" - | wl-copy',
)
# rofi
riverctl("map", "normal", MOD, "Space", "spawn", "rofi -show")
riverctl(
    "map",
    "normal",
    MOD,
    "escape",
    "spawn",
    "rofi -show power-grid -theme power-grid",
)


# --- 4. Tags (1-9) ---
for i in range(1, 9):
    tags = 1 << (i - 1)
    riverctl("map", "normal", MOD, str(i), "set-focused-tags", str(tags))
    riverctl("map", "normal", f"{MOD}+Shift", str(i), "set-view-tags", str(tags))
    riverctl(
        "map", "normal", f"{MOD}+Control", str(i), "toggle-focused-tags", str(tags)
    )
    riverctl(
        "map", "normal", f"{MOD}+Shift+Control", str(i), "toggle-view-tags", str(tags)
    )
    all_tags = (1 << 32) - 1
    riverctl("map", "normal", MOD, "0", "set-focused-tags", str(all_tags))

# rules
riverctl("rule-add", "-app-id", "term-float", "float")
riverctl("rule-add", "-app-id", "term-float", "dimensions", "800", "600")
riverctl("rule-add", "-app-id", "com.saivert.pwvucontrol", "float")
riverctl("rule-add", "-app-id", "firefox", "tags", "4")
riverctl("default-attach-mode", "below")


# --- 5. Aesthetics ---
riverctl("border-width", "2")
riverctl("border-color-focused", "0x535d6c")
riverctl("border-color-unfocused", "0x2e3440")
riverctl("set-cursor-theme", XCURSOR_THEME, XCURSOR_SIZE)
