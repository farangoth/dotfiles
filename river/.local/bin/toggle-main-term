#!/usr/bin/env bash
# Mod+Return: reveal the "main" tmux terminal if a term-main-tagged foot
# window already exists somewhere, otherwise spawn one. river/init pins
# term-main to tag 256 (bit 8) -- one of the tags above 1-8, so it's never
# reachable via Mod+1..8 and never included in Mod+0's "all tags" -- making
# it a dedicated, hidden slot the firefox rule's tag-4 idiom already uses
# for "jump to a known window". riverctl has no "does a window with this
# app-id exist" query, so pgrep against the running process list is the
# best available proxy. Spawning a plain `foot --app-id=term-main` is
# enough to get "main" attached: zsh's own tmux auto-attach
# (`exec tmux new-session -A -s main`) does the actual attach-or-create,
# so this script doesn't need to duplicate that logic.
#
# First spawn: `set-focused-tags` switches straight to it, same as
# launching any other app. Already open: `toggle-focused-tags` instead --
# merges tag 256 into whatever tags are currently viewed (mirrors the
# Mod+Control+<n> bindings in river/init, which use the same command for
# the same reason) rather than replacing the view outright, so pressing
# Mod+Return doesn't blow away whatever you were looking at. Since it's a
# toggle, pressing it again while term-main is already part of the view
# hides it -- consistent with how Mod+Control+<n> behaves everywhere else
# in this config.
set -euo pipefail

APP_ID="term-main"
TAG=256

if pgrep -f "app-id=$APP_ID" >/dev/null; then
    riverctl toggle-focused-tags "$TAG"
else
    foot --app-id="$APP_ID" &
    riverctl set-focused-tags "$TAG"
fi
