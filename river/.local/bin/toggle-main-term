#!/usr/bin/env bash
# Mod+Return: reveal the "main" tmux terminal if a foot window for it
# already exists somewhere, otherwise spawn one. The window's app-id is
# set to the tmux session name itself ("main") rather than a separate
# synthetic identifier -- one string to keep track of instead of two, and
# it generalizes cleanly if this reveal-or-spawn pattern is ever reused
# for another named session. river/init pins that app-id to tag 5 (also
# directly reachable via plain Mod+5) via its own rule.
#
# Existence check is `tmux list-clients -t main`, not a pgrep on foot's
# own argv (what this used before) -- checking tmux's own bookkeeping of
# who's actually attached is the authoritative answer to "is a window
# already showing main", whereas matching `--app-id=main` against the
# process list is an indirect proxy that depends on foot's exact argv
# shape and can silently fail to match, which was spawning a duplicate
# foot window on every press instead of revealing the existing one.
# `list-clients` exits 0 with empty output when the session exists but
# has no attached client, and exits 1 (message on stderr) when the
# session doesn't exist at all yet -- both cases correctly fall through
# to spawning here. Spawning a plain `foot --app-id=main` is enough to
# get the session attached: zsh's own tmux auto-attach
# (`exec tmux new-session -A -s main`) does the actual attach-or-create,
# so this script doesn't need to duplicate that logic.
#
# First spawn: `set-focused-tags` switches straight to it, same as
# launching any other app. Already open: `toggle-focused-tags` instead --
# merges tag 5 into whatever tags are currently viewed (mirrors the
# Mod+Control+<n> bindings in river/init, which use the same command for
# the same reason) rather than replacing the view outright, so pressing
# Mod+Return doesn't blow away whatever you were looking at. Since it's a
# toggle, pressing it again while the window is already part of the view
# hides it -- consistent with how Mod+Control+<n> behaves everywhere else
# in this config. This is what Mod+Return adds on top of plain Mod+5:
# spawn-if-missing, plus merge-into-view instead of replacing it.
set -euo pipefail

SESSION="main"
TAG=$((1 << (5 - 1))) # tag 5

if tmux list-clients -t "$SESSION" 2>/dev/null | grep -q .; then
    riverctl toggle-focused-tags "$TAG"
else
    foot --app-id="$SESSION" &
    riverctl set-focused-tags "$TAG"
fi
